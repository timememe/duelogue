extends RefCounted

## DUELOGUE — ЛЁГКИЙ МЫШИНЫЙ ПАРАЛЛАКС. Общая математика для stage_core.gd (общий план) и
## reaction_scene.gd (фон крупного плана): слой держит свою АВТОРСКУЮ базовую позицию (снятую
## один раз в _ready) и каждый кадр добавляет сглаженный офсет от положения мыши × собственная
## сила — «дальний» слой двигается меньше, «ближний» больше. Нет реальной Camera2D нигде в
## проекте — это симуляция глубины через позиции слоёв, не движение камеры.
##
## Глубину кодирует АМПЛИТУДА (strength у вызывающей стороны), не разный лаг сглаживания —
## один темп на все слои эффекта, чтобы «лёгкий» эффект и остался лёгким, а не обзавёлся
## отдельной системой физики.
##
## НЕ применять к узлам, которыми уже управляет tween в другом месте (см. reaction_scene.gd —
## портрет сознательно не участвует: там уже кассетный вход на ту же position, второй писатель
## того же кадра устроил бы ровно ту «борьбу за свойства», которой файл избегает по конструкции).
const SMOOTH_SPEED := 6.0


## Позиция мыши, нормализованная от центра вьюпорта в примерный диапазон [-1, 1] по каждой оси.
static func normalized_mouse(viewport: Viewport) -> Vector2:
	var size := viewport.get_visible_rect().size
	if size.x <= 0.0 or size.y <= 0.0:
		return Vector2.ZERO
	var m := viewport.get_mouse_position()
	return Vector2(
		clampf((m.x / size.x) * 2.0 - 1.0, -1.0, 1.0),
		clampf((m.y / size.y) * 2.0 - 1.0, -1.0, 1.0),
	)


## Экспоненциальный lerp текущего офсета к цели — сглаживает дрожь мыши в кадр-к-кадру.
static func step(current: Vector2, target: Vector2, delta: float) -> Vector2:
	return current.lerp(target, clampf(SMOOTH_SPEED * delta, 0.0, 1.0))
